# After applying bootstrap/remote-state, copy its `state_bucket_name` output here.
bootstrap_state_bucket = "replace-with-bootstrap-remote-state-output"
bootstrap_state_key = "astronomy-shop/bootstrap/staging/terraform.tfstate"
bootstrap_state_region = "ap-south-1"
gitops_repository_ssh_private_key_path = "~/.ssh/argocd_astronomy_shop_gitops"
alert_email = "platform-alerts@example.com"
create_application_ingress = false
application_hostname = "staging.example.com"
alb_certificate_arn = ""
alb_waf_acl_arn = ""
create_cert_manager_cluster_issuer = false
cert_manager_email = ""
enable_karpenter = true
enable_ingress = true
enable_argo_rollouts = true
enable_kubernetes_security = true
enable_workload_foundation = true
enable_external_secrets = true
enable_gitops = true
enable_observability = true
enable_metrics_server = true
enable_alertmanager = true
enable_loki = true
enable_opentelemetry_collector = true
enable_tempo = true
enable_observability_persistence = false
enable_cloudwatch = true
enable_velero = true
enable_finops = true
enable_kubecost = true
enable_kyverno = true
enable_falco = false
enable_signed_image_policy = false
# Keep false for the first platform apply. Change to true only after Argo CD
# has read-only access to the GitOps repository.
create_gitops_root_application = false
cloudwatch_log_retention_days = 30
